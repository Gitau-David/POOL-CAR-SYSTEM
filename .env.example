# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to sign the app's session cookie. Any long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Demo admin PIN (matches the seed row's pin_hash in db/schema.sql).
# If you change this, update the pin_hash in db/schema.sql to match
# (sha256 of the new PIN — see lib/session.ts hashPin()).
ADMIN_PIN=1234
